# Base URL of the Lambert AI backend API (built separately via OpenCode).
VITE_API_URL=https://api.lambertai.example.com

# Set to "true" once the real backend is deployed and reachable at VITE_API_URL.
# While false, every service call returns a BackendNotReadyError and pages
# render an honest "not connected yet" state instead of fake data.
VITE_BACKEND_READY=false
