# ---------------------------------------------------------------------------
# LAMBERT AI backend - environment configuration
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# ---- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database -------------------------------------------------------------
# PostgreSQL is the default engine (production runs on Render Postgres).
# Use the internal connection string on Render, e.g.:
#   DATABASE_URL="postgresql://user:password@redacted-host/lambertai"
# For local SQLite, change the provider in prisma/schema.prisma back to
# "sqlite" and set DATABASE_URL="file:./dev.db".
DATABASE_URL="postgresql://user:password@localhost:5432/lambertai"

# ---- Auth / Security ------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-string
PASSWORD_RESET_TTL=1h
BCRYPT_ROUNDS=10

# ---- File storage ---------------------------------------------------------
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# ---- AI providers ---------------------------------------------------------
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Microsoft / Azure OpenAI (leave blank to disable this provider)
MICROSOFT_AI_ENDPOINT=
MICROSOFT_AI_API_KEY=
MICROSOFT_AI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenRouter (OpenAI-compatible gateway; rotate the key you pasted in chat!)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Voice (optional) -----------------------------------------------------
VOICE_TRANSCRIBE_URL=
VOICE_TRANSCRIBE_KEY=
VOICE_SYNTHESIZE_URL=
VOICE_SYNTHESIZE_KEY=

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=info